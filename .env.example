# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional preferred Gemini model in production (defaults to gemini-2.5-flash fallback if preview alias is unavailable).
GEMINI_MODEL="gemini-2.5-flash"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform APIs.
# AI Studio automatically injects provisioned Google Maps credentials at runtime.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
